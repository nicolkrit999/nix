# Languages: typescript, javascript, java, kotlin, php, ruby, csharp, go, python, sql

### Universal ###
# Common files that should be ignored in all projects

# Logs
*.log
# Temporary files
*.tmp
*~
*.bak

# Environment files (containing secrets, API keys, credentials)
.env
*.env
.env.*
!.env.example

# Local configuration that shouldn't be shared
*.local

# Nix / direnv
.direnv/
result
result-*

### Python ###
__pycache__/
*.py[cod]
.venv/

